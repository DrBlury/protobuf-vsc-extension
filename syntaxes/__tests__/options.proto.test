// SYNTAX TEST "source.proto" "Options at various levels"

syntax = "proto3";

option java_package = "com.example";
// <-- keyword.control.option.proto
//     ^^^^^^^^^^^^ support.other.option.proto

option java_multiple_files = true;
//     ^^^^^^^^^^^^^^^^^^^ support.other.option.proto

message WithMessageOptions {
  option deprecated = true;
//^^^^^^ keyword.control.option.proto
//       ^^^^^^^^^^ support.other.option.proto
//                    ^^^^ constant.language.proto
}

enum WithEnumOptions {
  option allow_alias = true;
//^^^^^^ keyword.control.option.proto

  VALUE_ZERO = 0 [deprecated = true];
//^^^^^^^^^^ variable.other.enummember.proto
//           ^ keyword.operator.assignment.proto
//             ^ constant.numeric.proto
//               ^ punctuation.definition.brackets.begin.proto
//                ^^^^^^^^^^ support.other.option.proto
//                             ^^^^ constant.language.proto
//                                 ^ punctuation.definition.brackets.end.proto
}

option optimize_for = CODE_SIZE;
//     ^^^^^^^^^^^^ support.other.option.proto
//                  ^ keyword.operator.assignment.proto
//                    ^^^^^^^^^ constant.language.enum.proto

option features.field_presence = IMPLICIT;
//                             ^ keyword.operator.assignment.proto
//                               ^^^^^^^^ constant.language.enum.proto

service WithEnumOptionValue {
  rpc Get(Empty) returns (Empty) {
    option idempotency_level = NO_SIDE_EFFECTS;
//                           ^ keyword.operator.assignment.proto
//                             ^^^^^^^^^^^^^^^ constant.language.enum.proto
  }
}
